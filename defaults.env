# Generic defaults for the development VM. Site-specific values live in
# ~/.config/modama-devvm/site.env (see `devvm.sh setup`), one-off overrides in
# the environment (e.g. RAM_MB=32768 ./devvm.sh create).

# VM_NAME is not set here: it defaults to $VM_PREFIX<branch of this checkout>, so each
# worktree gets its own VM. Set it to change the default, or
# address another VM with `devvm.sh -n NAME ...`. `ls` shows
# all VMs whose name starts with the prefix.
VM_PREFIX=modama-
VCPUS=8
RAM_MB=16384
DISK_GB=80

LIBVIRT_URI=qemu:///system
NETWORK=default

# Debian cloud image, pinned to a release so that test runs are reproducible.
# Releases: https://cloud.debian.org/images/cloud/trixie/
IMAGE_BASE_URL=https://cloud.debian.org/images/cloud/trixie
IMAGE_RELEASE=20261026-2643
IMAGE_VARIANT=genericcloud
OS_VARIANT=debian13

# User created in the VM, and the repository checkout in its home
VM_USER=dev
VM_REPO=data-management-system

# Generic defaults of devvm. A project overrides them in its .devvm/config.env, the
# user's site-specific values live in ~/.config/devvm/site.env (see `devvm setup`),
# one-off overrides in the environment (e.g. RAM_MB=32768 devvm create).

# VM_NAME is not set here: it defaults to $VM_PREFIX<branch of the current checkout>,
# so each worktree gets its own VM. Set it to change the default, or address another
# VM with `devvm -n NAME ...`. `ls` shows all VMs whose name starts with the prefix.
# VM_PREFIX defaults to "<repository name>-".
#VM_PREFIX=
VCPUS=8
RAM_MB=16384
DISK_GB=80

LIBVIRT_URI=qemu:///system
NETWORK=default

# Debian cloud image, pinned to a release so that test runs are reproducible.
# Releases: https://cloud.debian.org/images/cloud/trixie/
IMAGE_BASE_URL=https://cloud.debian.org/images/cloud/trixie
IMAGE_RELEASE=20261026-2643
IMAGE_VARIANT=genericcloud
OS_VARIANT=debian13

# Debian packages installed by cloud-init; projects usually extend this list, e.g.
# PACKAGES="$PACKAGES build-essential" in .devvm/config.env
PACKAGES="git curl ca-certificates docker.io docker-compose docker-buildx"

# User created in the VM (with passwordless sudo and in the docker group). It gets the
# uid and gid of the host user, so files in shared folders belong to the same user on
# both sides.
VM_USER=dev

# Like devcontainers: the checkout is shared into the VM read-write (virtiofs), at
# WORKSPACE_ROOT/<folder name>. With SHARE_WORKSPACE=0, the VM gets commits by
# `devvm push` instead, into the checkout ~/VM_REPO (default: the repository name).
SHARE_WORKSPACE=1
WORKSPACE_ROOT=/workspaces
#VM_REPO=

# Further mounts, in devcontainer "mounts" syntax, separated by whitespace or newlines:
#   source=PATH,target=PATH[,type=bind][,readonly]   a host folder (virtiofs)
#   source=NAME,target=PATH,type=volume               a folder on the VM's disk
# A relative source is relative to the checkout, a relative target to the workspace
# in the VM; ${localWorkspaceFolder}, ${containerWorkspaceFolder} and ${localEnv:VAR}
# are substituted (use single quotes in config.env). Volumes over subfolders of the
# workspace keep build output, containers' data and ACLs (which the share does not
# support) in the VM. Mounts are fixed when the VM is created.
MOUNTS=

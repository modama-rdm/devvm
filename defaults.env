# Generic defaults for the development VM. Site-specific values go in site.env,
# one-off overrides in the environment (e.g. RAM_MB=32768 ./devvm.sh create).

VM_NAME=modama-dev
VCPUS=8
RAM_MB=16384
DISK_GB=80

LIBVIRT_URI=qemu:///system
NETWORK=default

IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest
IMAGE_FILE=debian-13-genericcloud-amd64.qcow2
OS_VARIANT=debian13

# User created in the VM
VM_USER=dev

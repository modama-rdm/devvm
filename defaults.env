# Generic defaults of devvm. A project overrides them in its .devvm/config.env, the
# user's site-specific values live in ~/.config/devvm/site.env (see `devvm setup`),
# one-off overrides in the environment (e.g. DEVVM_RAM_MB=32768 devvm create).

# DEVVM_VM_NAME is not set here: it defaults to $DEVVM_VM_PREFIX<branch of the
# current checkout>, so each worktree gets its own VM. Set it to change the default, or
# address another VM with `devvm -n NAME ...`. `ls` shows all VMs whose name starts
# with the prefix.
# DEVVM_VM_PREFIX defaults to "<repository name>-".
#DEVVM_VM_PREFIX=
DEVVM_VCPUS=8
DEVVM_RAM_MB=16384
DEVVM_DISK_GB=80

DEVVM_LIBVIRT_URI=qemu:///system
DEVVM_NETWORK=default

# Debian cloud image, pinned to a release so that test runs are reproducible.
# Releases: https://cloud.debian.org/images/cloud/trixie/
DEVVM_IMAGE_BASE_URL=https://cloud.debian.org/images/cloud/trixie
DEVVM_IMAGE_RELEASE=20261026-2643
DEVVM_IMAGE_VARIANT=genericcloud
DEVVM_OS_VARIANT=debian13

# Debian packages installed by cloud-init; projects usually extend this list, e.g.
# DEVVM_PACKAGES="$DEVVM_PACKAGES build-essential" in .devvm/config.env
DEVVM_PACKAGES="git curl ca-certificates docker.io docker-compose docker-buildx"

# User created in the VM (with passwordless sudo and in the docker group). It gets the
# uid and gid of the host user, so files in shared folders belong to the same user on
# both sides.
DEVVM_VM_USER=dev

# Like devcontainers: the checkout is shared into the VM read-write (virtiofs), at
# DEVVM_WORKSPACE_ROOT/<folder name>. With DEVVM_SHARE_WORKSPACE=0, the VM gets
# commits by `devvm push` instead, into the checkout ~/DEVVM_VM_REPO (default: the
# repository name).
DEVVM_SHARE_WORKSPACE=1
DEVVM_WORKSPACE_ROOT=/workspaces
#DEVVM_VM_REPO=

# Further mounts, in devcontainer "mounts" syntax, separated by whitespace or newlines:
#   source=PATH,target=PATH[,type=bind][,readonly]   a host folder (virtiofs)
#   source=NAME,target=PATH,type=volume               a folder on the VM's disk
# A relative source is relative to the checkout, a relative target to the workspace
# in the VM; ${localWorkspaceFolder}, ${containerWorkspaceFolder} and ${localEnv:VAR}
# are substituted (use single quotes in config.env). Volumes over subfolders of the
# workspace keep build output, containers' data and ACLs (which the share does not
# support) in the VM. Mounts are fixed when the VM is created.
DEVVM_MOUNTS=

# Opt-in, in site.env: a file with a Claude Code token from `claude setup-token` on the
# host, which `devvm setup-dev` installs in the VM, so that claude needs no login there.
# Anything running in the VM can then use the token.
DEVVM_CLAUDE_TOKEN_FILE=

#!/bin/bash
# devvm: disposable libvirt/KVM development VMs, one per git branch or worktree.
#
# Acts on the git repository of the current directory (the "project"). Settings, each
# overriding the previous: defaults.env next to this script < the project's
# .devvm/config.env < ~/.config/devvm/site.env < environment. A project can add
# provisioning (.devvm/provision.sh) and commands (.devvm/commands.sh). See README.md.
set -euo pipefail

# Resolved, so that a symlink on PATH (e.g. ~/.local/bin/devvm) finds the tool's files
HERE=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
PROG=$(basename "$0")

# Under sudo only libvirt needs root; files, downloads and SSH belong to the invoking user
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    USER_NAME=$SUDO_USER
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    as_user() { sudo -u "$SUDO_USER" -- "$@"; }
else
    USER_NAME=$(id -un)
    USER_HOME=$HOME
    as_user() { "$@"; }
fi

# Members of the libvirt group may manage qemu:///system without root
# Without sudo: the groups of this process (a fresh usermod needs a new login);
# under sudo: the invoking user's groups
in_libvirt_group() {
    if [ -n "${SUDO_USER:-}" ]; then id -nG "$USER_NAME"; else id -nG; fi | tr ' ' '\n' | grep -qx libvirt
}
libvirt_group_hint() {
    # Already added, but this login predates it
    if id -nG "$USER_NAME" | tr ' ' '\n' | grep -qx libvirt; then
        echo "$USER_NAME is in the libvirt group, but this session is not yet. Log in again" >&2
        echo "(or start a shell with: newgrp libvirt) to run $PROG without sudo." >&2
        return
    fi
    echo "Add $USER_NAME to the libvirt group to run $PROG without sudo:" >&2
    echo "    sudo usermod -aG libvirt $USER_NAME" >&2
    echo "then log in again (or start a shell with: newgrp libvirt)." >&2
}

# Site-specific settings of the invoking user, shared by all projects, created by `setup`
SITE_ENV=$USER_HOME/.config/devvm/site.env

# Ask a yes/no question; exits unless answered with y. Without a terminal there is no one
# to ask, so fail loudly instead of reading EOF; HINT says how to skip the question.
confirm() {
    local prompt=$1 hint=${2:-} answer
    if [ ! -t 0 ]; then
        echo "$prompt: no terminal to confirm${hint:+; $hint}" >&2
        exit 1
    fi
    read -rp "$prompt [y/N] " answer
    [ "$answer" = y ] || { echo "Aborted" >&2; exit 1; }
}

cmd_setup() {
    local pool pubkey default_key f
    if [ -f "$SITE_ENV" ]; then
        confirm "$SITE_ENV exists, overwrite?" "remove it first"
    fi
    echo "Directory for base images, VM disks and SSH host keys of all projects. Needs"
    echo "~100 GB per VM and must be traversable (x) by the libvirt-qemu user."
    read -rp "DEVVM_POOL_DIR [/var/lib/libvirt/images/devvm]: " pool
    pool=${pool:-/var/lib/libvirt/images/devvm}
    default_key=
    for f in "$USER_HOME"/.ssh/id_*.pub; do
        [ -e "$f" ] && { default_key=$f; break; }
    done
    read -rp "Public key that may log in to the VMs [${default_key:-none found}]: " pubkey
    pubkey=${pubkey:-$default_key}
    as_user test -r "$pubkey" || { echo "Cannot read $pubkey" >&2; exit 1; }
    case "$pool$pubkey" in *[[:space:]]*) echo "Paths must not contain whitespace" >&2; exit 1 ;; esac
    if ! as_user mkdir -p "$pool" 2>/dev/null; then
        echo "Cannot create $pool as $USER_NAME. Create it writable for that user, e.g." >&2
        echo "    sudo install -d -o $USER_NAME $pool" >&2
        exit 1
    fi
    chmod o+x "$pool" 2>/dev/null || true   # libvirt-qemu must be able to traverse it
    as_user mkdir -p "$(dirname "$SITE_ENV")"
    as_user tee "$SITE_ENV" > /dev/null <<EOF
# Site-specific settings for devvm, written by \`devvm setup\` on $(date -I).
# They apply to all projects. Generic defaults are in defaults.env next to devvm,
# project settings in .devvm/config.env of each project; any variable can be
# overridden per command in the environment, e.g. DEVVM_RAM_MB=32768 devvm create

# Directory for base images, VM disks and SSH host keys (~100 GB per VM, must be
# traversable by the libvirt-qemu user)
DEVVM_POOL_DIR=$pool

# Public key that is authorized to log in to the VMs
DEVVM_SSH_PUBKEY_FILE=$pubkey
EOF
    echo "Wrote $SITE_ENV"
    if in_libvirt_group; then
        echo "$USER_NAME is in the libvirt group, no sudo needed"
    else
        libvirt_group_hint
    fi
}

# The project: the git repository of the current directory, if any
REPO_ROOT=$(as_user git rev-parse --show-toplevel 2>/dev/null || true)
PROJECT_DIR=${REPO_ROOT:+$REPO_ROOT/.devvm}

cmd_init() {
    [ -n "$REPO_ROOT" ] || { echo "Not in a git repository" >&2; exit 1; }
    [ -e "$PROJECT_DIR/config.env" ] && { echo "$PROJECT_DIR/config.env exists" >&2; exit 1; }
    as_user mkdir -p "$PROJECT_DIR"
    as_user tee "$PROJECT_DIR/config.env" > /dev/null <<EOF
# devvm settings for this project; they override devvm's defaults.env, see its README.
# Commit this file. Optional companions in this folder: provision.sh (runs once in a
# new VM as the VM user) and commands.sh (project-specific devvm commands).

# VMs of this project are named <prefix><branch>
DEVVM_VM_PREFIX=$(default_prefix)

# Debian packages installed in the VM
#DEVVM_PACKAGES="\$DEVVM_PACKAGES build-essential"

#DEVVM_VCPUS=4
#DEVVM_RAM_MB=8192
#DEVVM_DISK_GB=40
EOF
    echo "Wrote $PROJECT_DIR/config.env"
}

# Name of the project's main checkout (also for linked worktrees), as a VM name stem
repo_name() {
    local common
    common=$(as_user git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir)
    case "$common" in */.git) common=${common%/.git} ;; esac
    basename "$common"
}
default_prefix() { echo "$(repo_name | tr -c 'A-Za-z0-9\n' '-')-"; }

# Global option: -n VM addresses a VM other than this checkout's own
OPT_VM_NAME=
while [ $# -gt 0 ]; do
    case $1 in
        -n|--vm) OPT_VM_NAME=${2:?-n needs a VM}; shift 2 ;;
        -n*) OPT_VM_NAME=${1#-n}; shift ;;
        *) break ;;
    esac
done

# devvm updates itself from the git clone it runs from, see install.sh
require_clone() {
    as_user git -C "$HERE" rev-parse --is-inside-work-tree > /dev/null 2>&1 ||
        { echo "$HERE is not a git clone; update devvm the way it was installed" >&2; exit 1; }
}
cmd_update() {
    require_clone
    as_user git -C "$HERE" pull --ff-only
    echo "devvm $(cmd_version)"
}
cmd_version() {
    require_clone
    as_user git -C "$HERE" describe --tags --always --dirty
}

case "${1:-}" in
    setup) cmd_setup; exit 0 ;;
    init) cmd_init; exit 0 ;;
    update) cmd_update; exit 0 ;;
    version) cmd_version; exit 0 ;;
esac

NO_COMMAND=
if [ $# -eq 0 ]; then
    NO_COMMAND=1   # only the usage text follows, which needs no libvirt or site config
elif [ "$(id -u)" != 0 ] && ! in_libvirt_group; then
    libvirt_group_hint
    exit 1
fi

# Exported variables are overrides from the environment; re-apply them after sourcing
saved_env=$(export -p)
# shellcheck source=defaults.env
source "$HERE/defaults.env"
if [ -n "$PROJECT_DIR" ] && [ -f "$PROJECT_DIR/config.env" ]; then
    # shellcheck source=/dev/null
    source "$PROJECT_DIR/config.env"
fi
if [ -f "$SITE_ENV" ]; then
    # shellcheck source=/dev/null
    source "$SITE_ENV"
elif [ -n "$NO_COMMAND" ]; then
    DEVVM_POOL_DIR=/unconfigured DEVVM_SSH_PUBKEY_FILE=/unconfigured
else
    echo "Missing $SITE_ENV, run: $PROG setup" >&2
    exit 1
fi
eval "$saved_env"
[ -n "$OPT_VM_NAME" ] && DEVVM_VM_NAME=$OPT_VM_NAME
if [ -n "$REPO_ROOT" ]; then
    : "${DEVVM_VM_REPO:=$(repo_name)}"
    : "${DEVVM_VM_PREFIX:=$(default_prefix)}"
fi

# One VM per checkout: the name defaults to the branch of the current directory, so
# every worktree gets its own VM with its own disk, snapshots and host refs.
# Without a branch (detached HEAD, or not in a repository) there is no default, and
# only the usage text and ls work without -n.
if [ -z "${DEVVM_VM_NAME:-}" ]; then
    branch=
    [ -n "$REPO_ROOT" ] && branch=$(as_user git -C "$REPO_ROOT" symbolic-ref --short -q HEAD || true)
    if [ -n "$branch" ]; then
        DEVVM_VM_NAME=$DEVVM_VM_PREFIX$(tr -c 'A-Za-z0-9\n' '-' <<< "$branch")
    else
        case "${1:-}" in
            ""|ls) DEVVM_VM_NAME= ;;
            *)
                if [ -n "$REPO_ROOT" ]; then
                    echo "Detached HEAD, no default VM: pass -n VM (see: $PROG ls)" >&2
                else
                    echo "Not in a git repository, no default VM: pass -n VM (see: $PROG ls -a)" >&2
                fi
                exit 1 ;;
        esac
    fi
fi
# The VM user gets the host user's ids, so that files in shared folders belong to the
# same user on both sides. System ids (e.g. root) exist in the image already; the VM
# user then gets the first regular ones.
VM_UID=$(id -u "$USER_NAME")
VM_GID=$(id -g "$USER_NAME")
[ "$VM_UID" -ge 1000 ] || VM_UID=1000
[ "$VM_GID" -ge 1000 ] || VM_GID=1000

# The name is a libvirt domain, a file name stem, a hostname and an ssh alias
[ -z "$DEVVM_VM_NAME" ] || [[ $DEVVM_VM_NAME =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || { echo "Invalid VM name: $DEVVM_VM_NAME" >&2; exit 1; }
case "$DEVVM_POOL_DIR" in *[[:space:]]*|"") echo "DEVVM_POOL_DIR must be an absolute path without whitespace" >&2; exit 1 ;; esac

# virt-install needs the system python (python3-gi); e.g. conda envs on PATH break it
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LIBVIRT_DEFAULT_URI=$DEVVM_LIBVIRT_URI

IMAGE_URL=$DEVVM_IMAGE_BASE_URL/$DEVVM_IMAGE_RELEASE
IMAGE_FILE=debian-13-$DEVVM_IMAGE_VARIANT-amd64-$DEVVM_IMAGE_RELEASE.qcow2
DISK=$DEVVM_POOL_DIR/$DEVVM_VM_NAME.qcow2
BASE_DIR=$DEVVM_POOL_DIR/base
# The VM's SSH host key is generated here once and installed by cloud-init, so the
# VM's identity is known before the first connection and survives re-creation
HOSTKEY=$DEVVM_POOL_DIR/$DEVVM_VM_NAME.hostkey
KNOWN_HOSTS=$DEVVM_POOL_DIR/$DEVVM_VM_NAME.known_hosts
SSH_OPTS="-o UserKnownHostsFile=$KNOWN_HOSTS -o HostKeyAlias=$DEVVM_VM_NAME -o StrictHostKeyChecking=yes"

# Project commands: .devvm/commands.sh defines project_cmd_<name> functions (with -
# in <name> written as _) and may append lines to PROJECT_USAGE
PROJECT_USAGE=
if [ -n "$PROJECT_DIR" ] && [ -f "$PROJECT_DIR/commands.sh" ]; then
    # shellcheck source=/dev/null
    source "$PROJECT_DIR/commands.sh"
fi

usage() {
    cat <<EOF
Usage: $PROG [-n VM] COMMAND [ARGS]

Project: ${REPO_ROOT:-none (not in a git repository)}
All commands act on the VM of this checkout, ${DEVVM_VM_NAME:-none without a branch}, unless -n VM
(long form --vm VM, or DEVVM_VM_NAME=VM in the environment) selects another one.

  setup             write the site settings to ~/.config/devvm/site.env
  init              create .devvm/config.env for the project
  update            update devvm itself (git pull in $HERE)
  version           print devvm's version
  ls [-a]           list the VMs of this project, with -a all VMs on this host;
                    * marks the one of this checkout
  create [--no-wait]
                    download base image, create and start the VM; shares this checkout
                    at $DEVVM_WORKSPACE_ROOT/<folder> unless DEVVM_SHARE_WORKSPACE=0, and DEVVM_MOUNTS;
                    then waits for it (as wait) and takes snapshot "clean", unless --no-wait
  wait              wait until cloud-init (and the project's provisioning) has finished
  ssh [CMD...]      log in to the VM or run a command there
  ip                print the VM's IP address
  status            show VM state and snapshots
  start | stop      boot or shut down the VM
  snapshot [SNAP]   create snapshot SNAP of the VM (default: clean)
  reset [SNAP]      revert the VM to snapshot SNAP (default: clean)
  destroy [-y]      remove the VM, its disk and snapshots (keeps base image and host key)
  prune             delete base images that no VM disk and no current setting uses

  For VMs created with DEVVM_SHARE_WORKSPACE=0:
  push [REF]        push REF (default: the branch checked out here) from the host
                    repository to the VM's checkout ~/${DEVVM_VM_REPO:-REPO}; origin/BRANCH
                    becomes branch BRANCH in the VM
  fetch             fetch the VM's branches into the host as ${DEVVM_VM_NAME:-VM}/*
  setup-dev         copy the host's git identity and install Claude Code in the VM
EOF
    if [ -n "$PROJECT_USAGE" ]; then
        printf '\nCommands of this project (%s):\n%s\n' "$PROJECT_DIR/commands.sh" "$PROJECT_USAGE"
    fi
}

# Commands that act on the project's repository need one
require_repo() {
    [ -n "$REPO_ROOT" ] || { echo "Not in a git repository" >&2; exit 1; }
}

# Empty if the VM has no lease (yet) or is not running; never fails, so that
# callers under set -e get to report why
vm_ip() {
    virsh domifaddr "${1:-$DEVVM_VM_NAME}" --source lease 2>/dev/null |
        awk '/ipv4/ {sub("/.*", "", $4); print $4; exit}' || true
}

require_ip() {
    local ip state
    for _ in $(seq 60); do
        ip=$(vm_ip)
        if [ -n "$ip" ]; then
            echo "$ip"
            return
        fi
        if ! state=$(virsh domstate "$DEVVM_VM_NAME" 2>/dev/null); then
            echo "No VM $DEVVM_VM_NAME, see: $PROG ls" >&2
            exit 1
        fi
        if [ "$state" = "shut off" ]; then
            echo "$DEVVM_VM_NAME is shut off, see /var/log/libvirt/qemu/$DEVVM_VM_NAME.log" >&2
            exit 1
        fi
        sleep 3
    done
    echo "No IP address for $DEVVM_VM_NAME" >&2
    exit 1
}

# known_hosts is derived from the host key; HostKeyAlias keeps it independent of the IP
write_known_hosts() {
    [ -f "$HOSTKEY.pub" ] || { echo "No host key $HOSTKEY.pub, was the VM created by $PROG?" >&2; exit 1; }
    as_user mkdir -p "$DEVVM_POOL_DIR"
    echo "$DEVVM_VM_NAME $(cut -d' ' -f1,2 "$HOSTKEY.pub")" | as_user tee "$KNOWN_HOSTS" > /dev/null
}

vm_ssh() {
    local ip
    ip=$(require_ip)
    [ -f "$KNOWN_HOSTS" ] || write_known_hosts
    # shellcheck disable=SC2086
    as_user ssh $SSH_OPTS "$DEVVM_VM_USER@$ip" "$@"
}

# Run a local script in the VM with arguments. The script travels as an argument of
# bash -c, not on stdin: with bash -s, a command in it that reads stdin (e.g. docker
# compose exec without -T) would swallow the rest of the script. The whole command is
# one argument of the remote shell, so the script must stay well below 128 KiB.
vm_run() {
    local script=$1
    shift
    vm_ssh "bash -c $(printf '%q' "$(cat "$script")") $(printf '%q ' "$(basename "$script")" "$@")"
}

# git in the host repository, talking to the VM over SSH. Commits travel through the
# host, so the VM never holds credentials for the upstream repository.
vm_git() {
    require_repo
    [ -f "$KNOWN_HOSTS" ] || write_known_hosts
    as_user env GIT_SSH_COMMAND="ssh $SSH_OPTS" \
        git -C "$REPO_ROOT" "$@"
}

# Placeholder substitution. The key is a single-quoted YAML scalar in the template
# (a " #" in its comment would otherwise start a YAML comment), so ' is doubled;
# then the sed replacement specials are escaped.
render() {
    local pubkey
    pubkey=$(head -1 "$DEVVM_SSH_PUBKEY_FILE" | sed "s/'/''/g; s/[|&\\\\]/\\\\&/g")
    sed -e "s|@VM_NAME@|$DEVVM_VM_NAME|g" -e "s|@VM_USER@|$DEVVM_VM_USER|g" \
        -e "s|@VM_UID@|$VM_UID|g" -e "s|@VM_GID@|$VM_GID|g" \
        -e "s|@SSH_PUBKEY@|$pubkey|g" "$1"
}

# Shared folders (virtiofs) and VM-local volumes, from DEVVM_SHARE_WORKSPACE and DEVVM_MOUNTS;
# filled by plan_mounts, in mount order (parents before what is mounted into them)
FS_TAG=() FS_SRC=() FS_TGT=() FS_RO=() VOL_NAME=() VOL_TGT=()
# The checkout as seen in the VM ("containerWorkspaceFolder")
GUEST_WS=
# libvirt metadata namespace in which create records the shared workspace
META_URI=https://devvm.invalid/1

# Paths end up in fstab, libvirt XML and option strings: keep them simple
check_path() {
    case "$1" in
        /*) ;;
        *) echo "Not an absolute path: $1" >&2; exit 1 ;;
    esac
    case "$1" in
        *[[:space:],\"\'\\\&\<\>]*)
            echo "Unsupported characters (whitespace , \" ' \\ & < >) in path: $1" >&2; exit 1 ;;
    esac
}

# The devcontainer variables in a mount string
expand_vars() {
    local s=$1 var val
    # shellcheck disable=SC2016  # the ${...} are literal devcontainer variables
    s=${s//'${localWorkspaceFolder}'/"$REPO_ROOT"}
    # shellcheck disable=SC2016
    s=${s//'${localWorkspaceFolderBasename}'/"$(basename "$REPO_ROOT")"}
    # shellcheck disable=SC2016
    s=${s//'${containerWorkspaceFolder}'/"$GUEST_WS"}
    while [[ $s =~ \$\{localEnv:([A-Za-z_][A-Za-z0-9_]*)\} ]]; do
        var=${BASH_REMATCH[1]}
        if [ "$var" = HOME ]; then val=$USER_HOME; else val=${!var:-}; fi
        s=${s//"\${localEnv:$var}"/"$val"}
    done
    echo "$s"
}

add_fs() {
    check_path "$2"
    check_path "$3"
    FS_TAG+=("$1") FS_SRC+=("$2") FS_TGT+=("$3") FS_RO+=("$4")
}

plan_mounts() {
    local specs=() spec kvs kv key val src tgt type ro n=0 common
    GUEST_WS=/home/$DEVVM_VM_USER/${DEVVM_VM_REPO:-}
    if [ "$DEVVM_SHARE_WORKSPACE" = 1 ]; then
        require_repo
        GUEST_WS=$DEVVM_WORKSPACE_ROOT/$(basename "$REPO_ROOT")
        add_fs devvm-ws "$REPO_ROOT" "$GUEST_WS" ""
        # A linked worktree's .git file points to the main repository's git directory by
        # absolute host path; share that at the same path, so that git finds it
        common=$(as_user git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir)
        case "$common/" in
            "$REPO_ROOT"/*) ;;
            *) add_fs devvm-git "$common" "$common" "" ;;
        esac
    fi
    read -rd '' -a specs <<< "$DEVVM_MOUNTS" || true
    for spec in "${specs[@]}"; do
        src='' tgt='' type=bind ro=''
        IFS=, read -ra kvs <<< "$spec"
        for kv in "${kvs[@]}"; do
            key=${kv%%=*} val=
            [ "$key" = "$kv" ] || val=${kv#*=}
            case $key in
                source|src) src=$val ;;
                target|destination|dst) tgt=$val ;;
                type) type=$val ;;
                readonly|ro)
                    case $val in
                        ""|true|1) ro=1 ;;
                        false|0) ;;
                        *) echo "Invalid $kv in mount: $spec" >&2; exit 1 ;;
                    esac ;;
                consistency) ;;   # Docker Desktop on macOS only
                *) echo "Unsupported option $kv in mount: $spec" >&2; exit 1 ;;
            esac
        done
        if [ -z "$src" ] || [ -z "$tgt" ]; then
            echo "Mount needs source and target: $spec" >&2; exit 1
        fi
        tgt=$(expand_vars "$tgt")
        case $tgt in
            /*) ;;
            *)
                [ "$DEVVM_SHARE_WORKSPACE" = 1 ] ||
                    { echo "Relative target needs DEVVM_SHARE_WORKSPACE=1: $spec" >&2; exit 1; }
                tgt=$GUEST_WS/$tgt ;;
        esac
        tgt=$(realpath -m "$tgt")
        case $type in
            bind)
                src=$(expand_vars "$src")
                # shellcheck disable=SC2088  # a literal ~ in the mount string
                case $src in
                    "~"|"~/"*) src=$USER_HOME${src#\~} ;;
                    /*) ;;
                    *) require_repo; src=$REPO_ROOT/$src ;;
                esac
                [ -d "$src" ] || { echo "No folder $src for mount: $spec" >&2; exit 1; }
                n=$((n + 1))
                add_fs "devvm-m$n" "$(realpath "$src")" "$tgt" "$ro" ;;
            volume)
                [[ $src =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
                    { echo "Invalid volume name $src in mount: $spec" >&2; exit 1; }
                [ -z "$ro" ] || { echo "Volumes cannot be read-only: $spec" >&2; exit 1; }
                check_path "$tgt"
                VOL_NAME+=("$src") VOL_TGT+=("$tgt") ;;
            *) echo "Unsupported type $type in mount: $spec" >&2; exit 1 ;;
        esac
    done
}

# Runs first in the new VM, as root: mounts, recorded in fstab for later boots. Mount
# points are created as the VM user where possible, so that those inside a share
# belong to the host user.
guest_setup_script() {
    local i
    echo '#!/bin/bash'
    echo '# Generated by devvm: shared folders, volumes and the login directory of the VM user'
    echo 'set -euo pipefail'
    echo "U=$(printf %q "$DEVVM_VM_USER")"
    cat <<'EOS'
mkpoint() { runuser -u "$U" -- mkdir -p "$1" 2> /dev/null || mkdir -p "$1"; }
mount_fs() {   # TAG TARGET [ro]
    mkpoint "$2"
    echo "$1 $2 virtiofs defaults,nofail${3:+,ro} 0 0" >> /etc/fstab
    mount "$2"
}
mount_vol() {  # NAME TARGET
    install -d -o "$U" -g "$(id -g "$U")" "/var/lib/devvm/volumes/$1"
    mkpoint "$2"
    echo "/var/lib/devvm/volumes/$1 $2 none bind,nofail 0 0" >> /etc/fstab
    mount "$2"
}
EOS
    for i in "${!FS_TAG[@]}"; do
        echo "mount_fs $(printf '%q ' "${FS_TAG[i]}" "${FS_TGT[i]}") ${FS_RO[i]:+ro}"
    done
    for i in "${!VOL_NAME[@]}"; do
        echo "mount_vol $(printf '%q ' "${VOL_NAME[i]}" "${VOL_TGT[i]}")"
    done
    if [ "$DEVVM_SHARE_WORKSPACE" = 1 ] && [ "$GUEST_WS" != "$REPO_ROOT" ]; then
        # The repository records a linked worktree by its host path; without that path,
        # git in the VM considers the worktree prunable
        echo "if [ ! -e $(printf %q "$REPO_ROOT") ]; then"
        echo "    mkpoint $(printf %q "$(dirname "$REPO_ROOT")")"
        echo "    ln -s $(printf '%q ' "$GUEST_WS" "$REPO_ROOT")"
        echo "fi"
    fi
    echo "systemctl daemon-reload"
    # Login shells start in the workspace, like a devcontainer terminal
    echo "echo $(printf %q "if [ \"\$PWD\" = \"\$HOME\" ] && [ -d $GUEST_WS ]; then cd $GUEST_WS; fi") > /etc/profile.d/devvm-workspace.sh"
    # The host's git identity, as devcontainers copy .gitconfig
    local key val cmd=''
    for key in user.name user.email; do
        val=$(as_user git ${REPO_ROOT:+-C "$REPO_ROOT"} config "$key" || true)
        [ -z "$val" ] || cmd+="git config --global $key $(printf %q "$val") && "
    done
    if [ "$DEVVM_SHARE_WORKSPACE" = 1 ]; then
        # git gc would otherwise prune the host's other worktrees, whose folders the VM
        # does not see, from the shared repository
        cmd+="git config --global gc.worktreePruneExpire never && "
    fi
    echo "if command -v git > /dev/null; then su - \"\$U\" -c $(printf %q "${cmd}true"); fi"
}

# The parts of user-data that come from settings: packages, mounts, the project's
# provisioning script and the host key. Appended to the template as top-level keys.
user_data_extra() {
    local pkg
    [[ $DEVVM_PACKAGES =~ ^[A-Za-z0-9.+:\ -]*$ ]] || { echo "Invalid DEVVM_PACKAGES: $DEVVM_PACKAGES" >&2; exit 1; }
    echo "packages:"
    for pkg in $DEVVM_PACKAGES; do echo "  - $pkg"; done
    echo "runcmd:"
    echo "  - [/usr/local/lib/devvm/setup.sh]"
    echo "  - if command -v docker > /dev/null; then systemctl enable --now docker; fi"
    if [ -n "$PROJECT_DIR" ] && [ -f "$PROJECT_DIR/provision.sh" ]; then
        # Runs once, as the VM user, after the packages are installed; a failure makes
        # cloud-init, and with it `wait`, report an error
        echo "  - [su, '-', '$DEVVM_VM_USER', '-c', '/usr/local/lib/devvm/provision.sh']"
    fi
    echo "write_files:"
    echo "  - path: /usr/local/lib/devvm/setup.sh"
    echo "    permissions: '0755'"
    echo "    encoding: b64"
    echo "    content: $(guest_setup_script | base64 -w0)"
    if [ -n "$PROJECT_DIR" ] && [ -f "$PROJECT_DIR/provision.sh" ]; then
        echo "  - path: /usr/local/lib/devvm/provision.sh"
        echo "    permissions: '0755'"
        echo "    encoding: b64"
        echo "    content: $(base64 -w0 "$PROJECT_DIR/provision.sh")"
    fi
    echo "ssh_genkeytypes: [ed25519]"
    echo "ssh_keys:"
    echo "  ed25519_private: |"
    sed 's/^/    /' "$HOSTKEY"
    echo "  ed25519_public: $(cat "$HOSTKEY.pub")"
}

# The workspace in the VM if create shared the checkout; empty for a VM that gets
# commits by push
vm_workspace() {
    virsh metadata "$DEVVM_VM_NAME" --uri "$META_URI" 2> /dev/null |
        sed -n 's/.* guest="\([^"]*\)".*/\1/p'
}
vm_workspace_host() {
    virsh metadata "$DEVVM_VM_NAME" --uri "$META_URI" 2> /dev/null |
        sed -n 's/.* host="\([^"]*\)".*/\1/p'
}

# What to do with a new VM, for the two uses: interactive development and test runs
next_steps() {
    local ws=$GUEST_WS
    echo
    echo "$DEVVM_VM_NAME is ready, with snapshot \"clean\" to return to. Next, depending on the use:"
    echo "  Interactive development:"
    if [ "$DEVVM_SHARE_WORKSPACE" != 1 ]; then
        echo "    $PROG push               the branch checked out here, to ~/$DEVVM_VM_REPO in the VM"
    fi
    echo "    $PROG setup-dev          git identity from the host, install Claude Code"
    echo "    $PROG snapshot dev       optional: a baseline that keeps Claude Code ($PROG reset dev)"
    echo "    $PROG ssh                log in, then: claude"
    echo "  Test runs:"
    echo "    $PROG reset              before each run, back to \"clean\""
    if [ "$DEVVM_SHARE_WORKSPACE" != 1 ]; then
        echo "    $PROG push [REF]         the commit to test"
    fi
    echo "    $PROG ssh 'cd $ws && ...'   or a command in .devvm/commands.sh, see README"
}

cmd_create() {
    local no_wait=
    case "${1:-}" in
        --no-wait) no_wait=1 ;;
        "") ;;
        *) echo "Unknown option for create: $1" >&2; exit 1 ;;
    esac
    if virsh dominfo "$DEVVM_VM_NAME" &>/dev/null; then
        echo "VM $DEVVM_VM_NAME already exists" >&2
        exit 1
    fi
    [ -r "$DEVVM_SSH_PUBKEY_FILE" ] || { echo "Cannot read $DEVVM_SSH_PUBKEY_FILE" >&2; exit 1; }
    plan_mounts
    local fs_opts=() i
    if [ ${#FS_TAG[@]} -gt 0 ]; then
        # libvirt starts virtiofsd per share; it looks in these places
        if [ ! -x /usr/libexec/virtiofsd ] && [ ! -x /usr/lib/qemu/virtiofsd ]; then
            echo "Shared folders need virtiofsd on the host (Debian: apt install virtiofsd)," >&2
            echo "or set DEVVM_SHARE_WORKSPACE=0 and no bind DEVVM_MOUNTS" >&2
            exit 1
        fi
        # vhost-user devices such as virtiofs need the guest memory shared with virtiofsd
        fs_opts+=(--memorybacking "source.type=memfd,access.mode=shared")
        for i in "${!FS_TAG[@]}"; do
            fs_opts+=(--filesystem "type=mount,accessmode=passthrough,driver.type=virtiofs,source.dir=${FS_SRC[i]},target.dir=${FS_TAG[i]}${FS_RO[i]:+,readonly=yes}")
        done
    fi
    as_user mkdir -p "$BASE_DIR"

    if [ ! -f "$BASE_DIR/$IMAGE_FILE" ]; then
        as_user curl -fL -o "$BASE_DIR/$IMAGE_FILE.part" "$IMAGE_URL/$IMAGE_FILE"
        as_user curl -fL -o "$BASE_DIR/SHA512SUMS" "$IMAGE_URL/SHA512SUMS"
        (cd "$BASE_DIR" &&
            grep " $IMAGE_FILE\$" SHA512SUMS | sed "s|$IMAGE_FILE\$|$IMAGE_FILE.part|" |
            sha512sum -c -)
        as_user mv "$BASE_DIR/$IMAGE_FILE.part" "$BASE_DIR/$IMAGE_FILE"
    fi

    # Copy-on-write overlay, the base image stays untouched
    if [ -e "$DISK" ]; then
        echo "$DISK exists; run '$PROG -n $DEVVM_VM_NAME destroy' first" >&2
        exit 1
    fi

    local ci_dir
    ci_dir=$(mktemp -d)
    # Expanded now: ci_dir is local and gone when the EXIT trap runs. The directory
    # holds the VM's private host key, so it must not be left behind.
    # shellcheck disable=SC2064
    trap "rm -rf -- '$ci_dir'" EXIT
    # Host key: kept across re-creates, so a VM of this name keeps its identity
    if [ ! -f "$HOSTKEY" ]; then
        as_user ssh-keygen -q -t ed25519 -N '' -C "$DEVVM_VM_NAME host key" -f "$HOSTKEY"
    fi
    { render "$HERE/cloud-init/user-data.tmpl"; user_data_extra; } > "$ci_dir/user-data"
    render "$HERE/cloud-init/meta-data.tmpl" > "$ci_dir/meta-data"
    write_known_hosts

    as_user qemu-img create -q -f qcow2 -F qcow2 -b "$BASE_DIR/$IMAGE_FILE" "$DISK" "${DEVVM_DISK_GB}G"
    virsh net-start "$DEVVM_NETWORK" &>/dev/null || true
    virt-install --name "$DEVVM_VM_NAME" --vcpus "$DEVVM_VCPUS" --memory "$DEVVM_RAM_MB" \
        --cpu host-passthrough --osinfo "$DEVVM_OS_VARIANT" \
        --disk path="$DISK",bus=virtio \
        --network network="$DEVVM_NETWORK",model=virtio \
        --cloud-init "user-data=$ci_dir/user-data,meta-data=$ci_dir/meta-data,disable=on" \
        --graphics none --noautoconsole --import \
        "${fs_opts[@]}" \
        --video virtio  # without any display device the Debian kernel resets right after GRUB
    if [ "$DEVVM_SHARE_WORKSPACE" = 1 ]; then
        virsh metadata "$DEVVM_VM_NAME" --uri "$META_URI" --key devvm --live --config \
            --set "<workspace host=\"$REPO_ROOT\" guest=\"$GUEST_WS\"/>" > /dev/null
    fi

    local ip
    ip=$(require_ip)
    echo "$DEVVM_VM_NAME is at $ip"
    for i in "${!FS_TAG[@]}"; do
        echo "  shares ${FS_SRC[i]} at ${FS_TGT[i]}${FS_RO[i]:+ (read-only)}"
    done
    for i in "${!VOL_NAME[@]}"; do
        echo "  volume ${VOL_NAME[i]} at ${VOL_TGT[i]}"
    done
    if [ -n "$no_wait" ]; then
        echo "Next: $PROG wait && $PROG snapshot"
        return
    fi
    cmd_wait
    cmd_snapshot clean
    next_steps
}

cmd_wait() {
    local ip err='' start=$SECONDS rc=0
    ip=$(require_ip)
    echo "Waiting for SSH on $DEVVM_VM_NAME ($ip) ..."
    # Probe without prompts: BatchMode, so that a passphrase prompt cannot block a retry
    # loop. Permission denied means that sshd is up and checked the key, but the key
    # needs interaction (a passphrase without ssh-agent, a security key); the rest
    # then runs in one ordinary session that can prompt once.
    for _ in $(seq 100); do
        if err=$(vm_ssh -o ConnectTimeout=5 -o BatchMode=yes true 2>&1); then
            err=''
            break
        fi
        case "$err" in
            *"Host key verification failed"*|*"REMOTE HOST IDENTIFICATION"*)
                echo "$err" >&2; exit 1 ;;   # not a timing problem, retrying will not help
            *"Permission denied"*)
                echo "SSH is up, but the key cannot be used without interaction (passphrase?)."
                echo "Answer ssh's prompt below; loading the key with ssh-add avoids it."
                err=''
                break ;;
        esac
        if [ "$(virsh domstate "$DEVVM_VM_NAME")" = "shut off" ]; then
            echo "$DEVVM_VM_NAME is shut off" >&2; exit 1
        fi
        sleep 3
    done
    if [ -n "$err" ]; then
        echo "No SSH connection to $DEVVM_VM_NAME after $((SECONDS - start)) s; last error: $err" >&2
        exit 1
    fi
    echo "SSH is up after $((SECONDS - start)) s. Waiting for cloud-init: packages and the project's"
    echo "provisioning, usually a few minutes. To watch: $PROG ssh tail -f /var/log/cloud-init-output.log"
    # One session for the rest, so that a key with a passphrase is asked for once. A failed
    # package install or provisioning script shows up as a cloud-init error (exit 3).
    vm_ssh 'if ! cloud-init status --wait > /dev/null; then
            sudo tail -n 30 /var/log/cloud-init-output.log >&2
            exit 3
        fi
        if command -v docker > /dev/null; then
            docker version --format "Docker {{.Server.Version}}" && docker compose version ||
                echo "Docker is installed but not working" >&2
        fi' || rc=$?
    case $rc in
        0) echo "cloud-init done after $((SECONDS - start)) s" ;;
        3) echo "cloud-init reported an error, see above; details: $PROG ssh sudo cloud-init status --long" >&2
           exit 1 ;;
        *) echo "SSH to $DEVVM_VM_NAME failed (exit $rc)" >&2; exit 1 ;;
    esac
    eject_cdroms
}

# virt-install deletes its cloud-init ISO right after creating the VM, but the running
# VM keeps it in its CD drive until the next reboot. A snapshot taken before that would
# reference the missing file and could not be reverted, so eject it from the running VM.
eject_cdroms() {
    local _type device target source
    while read -r _type device target source; do
        if [ "$device" != cdrom ] || [ -z "$source" ] || [ "$source" = - ]; then continue; fi
        virsh change-media "$DEVVM_VM_NAME" "$target" --eject --live --force > /dev/null
    done < <(virsh domblklist "$DEVVM_VM_NAME" --details | tail -n +3)
}

cmd_snapshot() {
    [ "$(virsh domstate "$DEVVM_VM_NAME")" = running ] && eject_cdroms
    virsh snapshot-create-as "$DEVVM_VM_NAME" --name "${1:-clean}" --atomic
}

cmd_reset() {
    virsh snapshot-revert "$DEVVM_VM_NAME" --snapshotname "${1:-clean}" --running
    # The guest clock resumes at the time the snapshot was taken; NTP may take a while
    # (or be unreachable), so set it from the host
    vm_ssh -o ConnectTimeout=10 "sudo date -u -s @$(date -u +%s) > /dev/null" ||
        echo "Could not set the VM's clock, it may lag behind" >&2
}

cmd_status() {
    local ws
    virsh dominfo "$DEVVM_VM_NAME"
    ws=$(vm_workspace)
    if [ -n "$ws" ]; then
        echo "Workspace:      $(vm_workspace_host) at $ws"
    else
        echo "Workspace:      ~/$DEVVM_VM_REPO, by push and fetch"
    fi
    virsh snapshot-list "$DEVVM_VM_NAME"
}

cmd_destroy() {
    if [ "${1:-}" != "-y" ]; then
        confirm "Remove VM $DEVVM_VM_NAME with disk $DISK and all snapshots?" "use destroy -y"
    fi
    virsh destroy "$DEVVM_VM_NAME" &>/dev/null || true
    virsh undefine "$DEVVM_VM_NAME" --snapshots-metadata --remove-all-storage
    # The host key stays: a VM re-created under this name keeps its identity
    rm -f "$KNOWN_HOSTS"
}

cmd_ls() {
    local filter name state ip size snaps mark
    if [ "${1:-}" = -a ]; then
        filter=.
    elif [ -n "${DEVVM_VM_PREFIX:-}" ]; then
        filter="^$DEVVM_VM_PREFIX"
    else
        echo "Not in a git repository, listing all VMs" >&2
        filter=.
    fi
    printf '  %-28s %-10s %-16s %6s  %s\n' VM STATE IP USED SNAPSHOTS
    while read -r name; do
        [ -n "$name" ] || continue
        state=$(virsh domstate "$name")
        ip=$(vm_ip "$name")
        size=$(du -h "$DEVVM_POOL_DIR/$name.qcow2" 2>/dev/null | cut -f1 || true)
        snaps=$(virsh snapshot-list "$name" --name | grep -c . || true)
        mark=' '; [ "$name" = "$DEVVM_VM_NAME" ] && mark='*'
        printf '%s %-28s %-10s %-16s %6s  %s\n' "$mark" "$name" "$state" "${ip:--}" "${size:--}" "$snaps"
    done < <(virsh list --all --name | grep "$filter" | sort)
}

cmd_prune() {
    local keep=() disk img backing
    keep+=("$(realpath -m "$BASE_DIR/$IMAGE_FILE")")
    # Every VM disk in the pool is an overlay; keep what it is backed by. Paths are
    # canonicalised, a plain string compare could miss the image in use.
    for disk in "$DEVVM_POOL_DIR"/*.qcow2; do
        [ -e "$disk" ] || continue
        # -U: the disk may be in use by a running VM
        backing=$(qemu-img info -U --output=json "$disk" | python3 -c \
            'import json, sys; print(json.load(sys.stdin).get("full-backing-filename", ""))') ||
            { echo "Cannot inspect $disk, not pruning" >&2; exit 1; }
        [ -n "$backing" ] || { echo "$disk has no backing file, not pruning" >&2; exit 1; }
        keep+=("$(realpath -m "$backing")")
    done
    for img in "$BASE_DIR"/*.qcow2; do
        [ -e "$img" ] || continue
        if printf '%s\n' "${keep[@]}" | grep -qxF "$(realpath -m "$img")"; then
            echo "keep   $img"
        else
            echo "delete $img"
            as_user rm -f "$img"
        fi
    done
}

# The branch checked out in the host repository; the default for push
current_branch() {
    local b
    require_repo
    b=$(as_user git -C "$REPO_ROOT" symbolic-ref --short -q HEAD) ||
        { echo "Detached HEAD on the host, give the ref to push explicitly" >&2; exit 1; }
    echo "$b"
}

# push and fetch are for VMs without a shared checkout
require_unshared() {
    local ws
    ws=$(vm_workspace)
    [ -z "$ws" ] && return
    echo "$DEVVM_VM_NAME shares $(vm_workspace_host) at $ws, there is nothing to $1" >&2
    exit 1
}

cmd_push() {
    local ref=${1:-} branch ip new b r
    require_repo
    require_unshared push
    [ -n "$ref" ] || ref=$(current_branch)
    branch=${ref#origin/}
    as_user git -C "$REPO_ROOT" check-ref-format --branch "$branch" > /dev/null
    # check-ref-format allows shell metacharacters; the branch ends up in a remote command
    [[ $branch =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || { echo "Unsupported characters in branch name: $branch" >&2; exit 1; }
    # Check on the host first, so that a typo does not leave an empty repository in the VM
    as_user git -C "$REPO_ROOT" rev-parse -q --verify "$ref^{commit}" > /dev/null ||
        { echo "No commit $ref in $REPO_ROOT (for origin/*: git fetch origin first)" >&2; exit 1; }
    ip=$(require_ip)
    b=$(printf %q "$branch"); r=$(printf %q "$DEVVM_VM_REPO")
    # Pushing to the checked-out branch updates the VM's working tree if it is clean.
    # "new" as long as the VM repository has no commit, so that an interrupted first
    # push still gets its submodules on the next one.
    new=$(vm_ssh "{ test -d $r/.git || { git init -q -b $b $r &&
        git -C $r config receive.denyCurrentBranch updateInstead; }; } &&
        { git -C $r rev-parse -q --verify HEAD > /dev/null || echo new; }")
    vm_git push "$DEVVM_VM_USER@$ip:$DEVVM_VM_REPO" "$ref:refs/heads/$branch"
    if [ "$new" = new ]; then
        vm_ssh "cd $r && git reset -q --hard &&
            { git submodule update --init || echo 'Warning: not all submodules could be fetched' >&2; }"
    fi
}

cmd_fetch() {
    local ip
    require_repo
    require_unshared fetch
    ip=$(require_ip)
    vm_git fetch "$DEVVM_VM_USER@$ip:$DEVVM_VM_REPO" "+refs/heads/*:refs/remotes/$DEVVM_VM_NAME/*"
}

cmd_setup_dev() {
    local name email
    name=$(as_user git ${REPO_ROOT:+-C "$REPO_ROOT"} config user.name || true)
    email=$(as_user git ${REPO_ROOT:+-C "$REPO_ROOT"} config user.email || true)
    if [ -z "${DEVVM_CLAUDE_TOKEN_FILE:-}" ]; then
        vm_run "$HERE/guest/setup-dev.sh" "$name" "$email"
        echo "Log in on the first start of claude in the VM, or let setup-dev pass a token,"
        echo "see DEVVM_CLAUDE_TOKEN_FILE in the README."
    else
        as_user test -r "$DEVVM_CLAUDE_TOKEN_FILE" ||
            { echo "Cannot read DEVVM_CLAUDE_TOKEN_FILE $DEVVM_CLAUDE_TOKEN_FILE" >&2; exit 1; }
        case $(stat -c %a "$DEVVM_CLAUDE_TOKEN_FILE") in
            *00) ;;
            *) echo "Warning: $DEVVM_CLAUDE_TOKEN_FILE is readable by others; chmod 600 it" >&2 ;;
        esac
        # On stdin, not as an argument: arguments show up in process listings
        as_user cat "$DEVVM_CLAUDE_TOKEN_FILE" |
            vm_run "$HERE/guest/setup-dev.sh" "$name" "$email" --claude-token-stdin
    fi
    echo "Next: $PROG ssh, then: claude. Optionally, to keep Claude Code across resets:"
    echo "      $PROG snapshot dev, and later $PROG reset dev instead of reset"
}

case "${1:-}" in
    ls) shift; cmd_ls "$@" ;;
    create) shift; cmd_create "$@" ;;
    wait) cmd_wait ;;
    ssh) shift; vm_ssh "$@" ;;
    ip) require_ip ;;
    status) cmd_status ;;
    start) virsh start "$DEVVM_VM_NAME" ;;
    stop) virsh shutdown "$DEVVM_VM_NAME" ;;
    snapshot) cmd_snapshot "${2:-}" ;;
    reset) cmd_reset "${2:-}" ;;
    destroy) shift; cmd_destroy "$@" ;;
    prune) cmd_prune ;;
    push) shift; cmd_push "$@" ;;
    fetch) cmd_fetch ;;
    setup-dev) cmd_setup_dev ;;
    "") usage; exit 1 ;;
    *)
        fn=project_cmd_${1//-/_}
        if [[ $1 =~ ^[a-z][a-z0-9-]*$ ]] && declare -F "$fn" > /dev/null; then
            shift
            "$fn" "$@"
        else
            echo "Unknown command: $1" >&2
            usage >&2
            exit 1
        fi ;;
esac

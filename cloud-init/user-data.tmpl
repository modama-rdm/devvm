#cloud-config
# Placeholders (VM_NAME, VM_USER, SSH_PUBKEY between @ signs) are substituted by devvm.sh.
# devvm.sh appends packages, the project's provisioning script and the VM's host key,
# generated on the host. No host credentials, shared folders or secrets are passed in.
hostname: @VM_NAME@
# Created before the user, so that it exists even if PACKAGES has no Docker
groups: [docker]
users:
  - name: @VM_USER@
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - '@SSH_PUBKEY@'
package_update: true

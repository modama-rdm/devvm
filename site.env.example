# Site-specific settings. Copy to site.env (gitignored) and adapt.

# Directory for the base image, VM disk and the VM's known_hosts file.
# Needs ~100 GB free and must be traversable by the libvirt-qemu user.
POOL_DIR=/var/lib/libvirt/images/modama-dev

# Public key that is authorized to log in to the VM.
# USER_HOME is the home of the invoking user, also when running under sudo.
SSH_PUBKEY_FILE=$USER_HOME/.ssh/id_ed25519.pub

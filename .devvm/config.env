# devvm settings for developing devvm itself; they override devvm's defaults.env, see
# its README. provision.sh turns the VM into a devvm host, so that devvm can be run and
# tested inside its own VM (nested KVM).

# VMs of this project are named <prefix><branch>
DEVVM_VM_PREFIX=devvm-

# shellcheck for linting; libvirt/KVM, virt-install, qemu-img and virtiofsd to run devvm
# in the VM
DEVVM_PACKAGES="$DEVVM_PACKAGES shellcheck libvirt-daemon-system virtinst qemu-system-x86 qemu-utils virtiofsd"

#DEVVM_VCPUS=8
#DEVVM_RAM_MB=16384
#DEVVM_DISK_GB=80

# devvm test [lint] [unit] [e2e] [all]: see tests/run.sh
DEVVM_TEST_COMMAND=./tests/run.sh
